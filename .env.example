
# Node environment (development / production)
NODE_ENV=development

# Server Port
PORT=3000

# Prisma Database connection URL
# Use the connection string for your database (e.g. PostgreSQL, SQLite)
DATABASE_URL="postgresql://username:password@hostname:port/database?sslmode=require"

# OpenRouter API key untuk chatbot Event Kuy
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-api-key-here"

# Model OpenRouter yang dipakai chatbot (default: openai/gpt-4o-mini)
# Lihat daftar model: https://openrouter.ai/models
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
