generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String        @id @default(uuid())
  name          String
  email         String        @unique
  password      String
  role          String
  referralCode  String        @unique
  pointsBalance Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  Coupon        Coupon[]
  Event         Event[]
  PointRecord   PointRecord[]
  Review        Review[]
  Transaction   Transaction[]
}

model Event {
  id             String        @id @default(uuid())
  name           String
  description    String        @default("")
  code           String        @unique
  category       String
  price          Float
  capacity       Int
  availableSeats Int
  date           String
  time           String        @default("19:00")
  location       String
  status         String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organizerId    String?
  User           User?         @relation(fields: [organizerId], references: [id])
  Review         Review[]
  transactions   Transaction[]
}

model Transaction {
  id              String   @id @default(uuid())
  originalPrice   Float
  discountApplied Float
  finalPrice      Float
  pointsUsed      Int      @default(0)
  couponUsed      Boolean  @default(false)
  purchaseDate    String
  createdAt       DateTime @default(now())
  eventName       String
  buyerName       String
  eventId         String
  buyerId         String
  User            User     @relation(fields: [buyerId], references: [id])
  event           Event    @relation(fields: [eventId], references: [id])
}

model Review {
  id        String   @id @default(uuid())
  userName  String
  rating    Int
  feedback  String
  createdAt DateTime @default(now())
  eventId   String
  userId    String
  Event     Event    @relation(fields: [eventId], references: [id])
  User      User     @relation(fields: [userId], references: [id])
}

model PointRecord {
  id         String   @id @default(uuid())
  amount     Int
  source     String
  expiryDate String
  isUsed     Boolean  @default(false)
  createdAt  DateTime @default(now())
  userId     String
  User       User     @relation(fields: [userId], references: [id])
}

model Coupon {
  id         String   @id @default(uuid())
  code       String
  discount   Float
  expiryDate String
  isUsed     Boolean  @default(false)
  createdAt  DateTime @default(now())
  userId     String
  User       User     @relation(fields: [userId], references: [id])
}
